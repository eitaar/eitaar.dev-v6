---
import { getCollection } from "astro:content";
import Project from "../../components/Project.astro";
import Layout from "../../layouts/Layout.astro";
import { byNewest } from "../../lib/content";

const projects = (await getCollection("projects")).sort(byNewest);
---

<Layout title="projects" description="list of my project">
	<h3 class="pt-32 pb-8 text-6xl leading-none tracking-wide">Projects</h3>
	<div class="flex w-full flex-col">
		{projects.map((project) => <Project project={project} />)}
	</div>
</Layout>
