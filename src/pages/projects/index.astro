---
import { getCollection } from "astro:content";
import Project from "../../components/Project.astro";
import Layout from "../../layouts/Layout.astro";

const rawProjects = await getCollection("projects");
const projects = rawProjects.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<Layout title="projects" description="list of my project">
	<h3 class="pt-32 pb-8 text-6xl leading-none tracking-wide">Projects</h3>
	<div class="flex w-full flex-col">
		{projects.map((project) => <Project project={project} />)}
	</div>
</Layout>
