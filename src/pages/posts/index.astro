---
import { getCollection } from "astro:content";
import Post from "../../components/Post.astro";
import Layout from "../../layouts/Layout.astro";
import { byNewest } from "../../lib/content";

const posts = (await getCollection("posts")).sort(byNewest);
---

<Layout title="Posts" description="Articles, notes, and things I have learned.">
	<section class="pt-32 pb-16">
		<h1 class="pb-3 text-6xl leading-none tracking-wide">Posts</h1>
		<p class="max-w-xl pb-8 text-base leading-relaxed text-muted md:text-lg">
			Articles, notes, and things I have learned.
		</p>

		{
			posts.length > 0 ? (
				<div class="reveal flex w-full flex-col">
					{posts.map((post, index) => (
						<Post post={post} index={index} />
					))}
				</div>
			) : (
				<div class="border-t border-border py-10 text-muted">
					<p>No posts yet.</p>
				</div>
			)
		}
	</section>

	<script>
		const list = document.querySelector(".reveal");
		if (list) {
			const observer = new IntersectionObserver(
				([entry]) => {
					if (entry.isIntersecting) {
						list.classList.add("in-view");
						observer.disconnect();
					}
				},
				{ threshold: 0.08 },
			);
			observer.observe(list);
		}
	</script>
</Layout>
